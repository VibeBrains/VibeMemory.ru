---
import '@vibebrains/site-kit/styles/base.css'
import '../styles/theme.css'
import KitMetrika from '@vibebrains/site-kit/components/Metrika.astro'
import { languages, langPaths, langTags, type Lang } from '@vibebrains/site-kit/languages'
import Mark from '../components/Mark.astro'
import { links, metrika } from '../config/site'
import { useTranslations } from '../i18n'

/**
 * Shell of a public changelog page: the head with the page's own canonical and language alternates,
 * a slim header whose switcher points at the same page in the other language, and the shared footer
 * The kit Base hardcodes the landing canonicals, so the changelog keeps its own head; Metrika,
 * cookie banner, fonts and the client script are the same as on the landing
 */
interface Props {
  lang: Lang
  title: string
  description: string
  /** Address of this page in the base language: canonical and the x-default alternate */
  ruPath: string
  /** Address of this page in English */
  enPath: string
}

const { lang, title, description, ruPath, enPath } = Astro.props
const { t } = useTranslations(lang)
const site = Astro.site ?? new URL(Astro.url.origin)
const paths: Record<Lang, string> = { ru: ruPath, en: enPath }
const canonical = new URL(paths[lang], site).href
const langNames: Record<Lang, { code: string; name: string }> = {
  ru: { code: t('lang.ru.code'), name: t('lang.ru.name') },
  en: { code: t('lang.en.code'), name: t('lang.en.name') },
}
---

<!doctype html>
<html lang={langTags[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#09090b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languages.map((code) => <link rel="alternate" hreflang={langTags[code]} href={new URL(paths[code], site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(ruPath, site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={langTags[lang]} />
    <!-- Runs before the first paint: marks that scripts work, so reveal-on-scroll hides content only then -->
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <header class="header">
      <div class="container header-row">
        <a class="logo" href={langPaths[lang]} aria-label={t('header.home')}>
          <Mark size={30} />
          <span class="logo-word" aria-hidden="true">{t('brand')}</span>
        </a>
        <div class="lang" role="group" aria-label={t('lang.label')}>
          {
            languages.map((code, i) => (
              <>
                {i > 0 && (
                  <span class="lang-sep" aria-hidden="true">
                    |
                  </span>
                )}
                <a
                  class="lang-link"
                  href={paths[code]}
                  hreflang={langTags[code]}
                  lang={langTags[code]}
                  aria-label={langNames[code].name}
                  aria-current={code === lang ? 'true' : undefined}
                  data-lang-pick={code}
                >
                  {langNames[code].code}
                </a>
              </>
            ))
          }
        </div>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="container footer-row">
        <div class="brand">
          <a class="logo" href={langPaths[lang]} aria-label={t('header.home')}>
            <Mark size={28} />
            <span aria-hidden="true">{t('brand')}</span>
          </a>
          <p class="tagline">{t('footer.tagline')}</p>
        </div>
        <nav aria-label={t('footer.nav')}>
          <ul class="links">
            <li><a href={links.download} data-goal="download_click">{t('footer.download')}</a></li>
            <li><a href={links.signIn} data-goal="signin_click">{t('footer.signIn')}</a></li>
            <li><a href={links.terms}>{t('footer.terms')}</a></li>
            <li><a href={links.policy}>{t('footer.policy')}</a></li>
          </ul>
        </nav>
        <div class="bottom">
          <p>{t('footer.copyright', { year: new Date().getFullYear() })}</p>
          <a class="cookie-settings" href="#cookie-settings" data-cookie-settings>{t('footer.cookies')}</a>
        </div>
      </div>
    </footer>
    <KitMetrika
      counterId={metrika.counterId}
      cookie={metrika.cookie}
      policyHref={links.policy}
      texts={{
        title: t('cookie.title'),
        body: t('cookie.body'),
        policy: t('cookie.policy'),
        accept: t('cookie.accept'),
        essential: t('cookie.essential'),
      }}
    />
    <script>
      import '../scripts/main'
    </script>
  </body>
</html>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: var(--header-bg, rgb(9 9 11 / 0.72));
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: 12px;
    height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    color: var(--fg);
    border-radius: 8px;
  }

  .logo-word {
    font-family: var(--font-accent);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .logo:hover {
    color: var(--brand-bright);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-family: var(--font-accent);
    font-size: 14px;
  }

  .lang-sep {
    color: var(--fg-faint);
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    min-width: 32px;
    min-height: 40px;
    justify-content: center;
    color: var(--fg-muted);
  }

  .lang-link[aria-current='true'] {
    color: var(--fg);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--brand);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .lang-link:hover {
    color: var(--fg);
  }

  .footer {
    padding-block: 48px 32px;
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .footer-row {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 800px) {
    .footer-row {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .bottom {
      grid-column: 1 / -1;
    }
  }

  .brand {
    display: grid;
    gap: 10px;
  }

  .brand .logo {
    margin-right: 0;
    font-family: var(--font-accent);
    font-size: 17px;
    font-weight: 700;
  }

  .tagline {
    color: var(--fg-muted);
    font-size: 15px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .links a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .links a:hover {
    color: var(--fg);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--fg-faint);
    font-size: 14px;
  }

  .cookie-settings {
    color: var(--fg-muted);
    text-decoration: underline;
  }

  .cookie-settings:hover {
    color: var(--fg);
  }
</style>
