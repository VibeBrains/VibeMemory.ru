---
import KitBase from '@vibebrains/site-kit/components/Base.astro'
import '../styles/theme.css'
import type { Lang } from '@vibebrains/site-kit/languages'
import Metrika from '@vibebrains/site-kit/components/Metrika.astro'
import { LANG_STORAGE_KEY, links, metrika } from '../config/site'
import { useTranslations } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)
---

<KitBase
  lang={lang}
  title={t('meta.title')}
  description={t('meta.description')}
  skip={t('a11y.skip')}
  storageKey={LANG_STORAGE_KEY}
  themeColor="#09090b"
  faviconSvg="/favicon.svg"
>
  <slot />
  <Metrika
    counterId={metrika.counterId}
    cookie={metrika.cookie}
    policyHref={links.policy}
    texts={{
      title: t('cookie.title'),
      body: t('cookie.body'),
      policy: t('cookie.policy'),
      accept: t('cookie.accept'),
      essential: t('cookie.essential'),
    }}
  />
  <script>
    import '../scripts/main'
  </script>
</KitBase>
