---
import Lines from '@vibebrains/site-kit/components/Lines.astro'
import ChangelogLayout from '../../../layouts/Changelog.astro'
import { changelogArchivePath, changelogKeys, changelogRecords, recordPath } from '../../../changelog/records'
import { useTranslations } from '../../../i18n'

export function getStaticPaths() {
  return changelogRecords.map((record) => ({ params: { id: record.id } }))
}

const lang = 'en'
const { id } = Astro.params
const record = changelogRecords.find((entry) => entry.id === id)!
const keys = changelogKeys[record.id]
const { t } = useTranslations(lang)
const title = `${record.id} · ${t(keys.title)} — ${t('brand')}`
---

<ChangelogLayout
  lang={lang}
  title={title}
  description={t(keys.summary)}
  ruPath={recordPath('ru', record.id)}
  enPath={recordPath('en', record.id)}
>
  <main id="main">
    <article class="section" aria-labelledby="record-title">
      <div class="container container--narrow">
        <p class="eyebrow">
          {record.id}
          <span class="eyebrow-sep" aria-hidden="true">·</span>
          <time datetime={record.date}>{record.date}</time>
        </p>
        <h1 class="section-title" id="record-title">{t(keys.title)}</h1>
        <p class="lead">
          <Lines text={t(keys.summary)} />
        </p>
        <ul class="details">
          {
            t(keys.details)
              .split('\n')
              .map((line) => <li>{line}</li>)
          }
        </ul>
        <p class="back">
          <a class="btn btn--ghost" href={changelogArchivePath(lang)}>{t('changelog.back')}</a>
        </p>
      </div>
    </article>
  </main>
</ChangelogLayout>

<style>
  .container--narrow {
    max-width: 820px;
  }

  .eyebrow-sep {
    margin-inline: 6px;
  }

  .lead {
    display: grid;
    gap: 6px;
    margin-top: 20px;
    color: var(--fg-soft);
    font-size: 18px;
  }

  .details {
    display: grid;
    gap: 10px;
    margin-top: 28px;
    padding: 0;
    list-style: none;
  }

  .details li {
    position: relative;
    padding-left: 24px;
    color: var(--fg-muted);
    font-size: 16.5px;
    line-height: 1.6;
  }

  .details li::before {
    content: '';
    position: absolute;
    top: 0.68em;
    left: 2px;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--brand);
    transform: rotate(45deg);
  }

  .back {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }
</style>
