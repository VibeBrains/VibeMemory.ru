---
import KitHeader from '@vibebrains/site-kit/components/Header.astro'
import Mark from './Mark.astro'
import type { Lang } from '@vibebrains/site-kit/languages'
import { links } from '../config/site'
import { useTranslations } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)
---

<KitHeader
  lang={lang}
  brand={t('brand')}
  homeLabel={t('header.home')}
  navLabel={t('header.nav')}
  nav={[
    { href: '#how', label: t('header.how') },
    { href: '#pricing', label: t('header.pricing') },
    { href: '#faq', label: t('header.faq') },
  ]}
  langLabel={t('lang.label')}
  langNames={{
    ru: { code: t('lang.ru.code'), name: t('lang.ru.name') },
    en: { code: t('lang.en.code'), name: t('lang.en.name') },
  }}
  actions={[
    { kind: 'ghost', href: links.signIn, label: t('header.signIn') },
    { kind: 'primary', href: links.start, label: t('header.start') },
  ]}
>
  <Mark slot="logo" size={30} />
</KitHeader>
