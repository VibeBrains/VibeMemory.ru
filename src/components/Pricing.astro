---
import Lines from '@vibebrains/site-kit/components/Lines.astro'
import type { Lang } from '@vibebrains/site-kit/languages'
import { plans, weightExample, type SizeUnit } from '../config/pricing'
import { links } from '../config/site'
import { useTranslations, type Key } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)

const sizeKeys: Record<SizeUnit, Key> = { mb: 'pricing.size.mb', gb: 'pricing.size.gb' }
const number = new Intl.NumberFormat(lang)
// the memory bar is drawn at its true share, with a floor so it stays visible at all
const memoryShare = Math.max((weightExample.memoryMb / weightExample.sessionsMb) * 100, 0.6)
---

<section class="section pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">{t('pricing.eyebrow')}</p>
      <h2 class="section-title" id="pricing-title"><Lines text={t('pricing.title')} /></h2>
      <p class="section-lead"><Lines text={t('pricing.lead')} /></p>
    </div>

    <ul class="plans">
      {
        plans.map((plan, i) => {
          const free = plan.priceRub === 0
          return (
            <li class:list={['plan', { 'plan--free': free }]} data-reveal style={`--reveal-i: ${i}`}>
              <p class="plan-size">{t(sizeKeys[plan.unit], { value: plan.size })}</p>
              <p class="plan-price">{free ? t('pricing.free') : t('pricing.price', { amount: plan.priceRub })}</p>
              <p class="plan-period">
                {free ? t('pricing.freeCaption') : t('pricing.period')}
                {
                  free && (
                    <span class="plan-hint">
                      <button type="button" class="plan-hint-mark" aria-label={t('pricing.freeNoteLabel')} aria-describedby="free-note">
                        ?
                      </button>
                      <span class="plan-hint-text" id="free-note" role="tooltip">
                        <Lines text={t('pricing.freeNote')} />
                      </span>
                    </span>
                  )
                }
              </p>
              <a class:list={['btn', free ? 'btn--primary' : 'btn--ghost']} href={links.start}>
                {free ? t('pricing.cta.free') : t('pricing.cta.paid')}
              </a>
            </li>
          )
        })
      }
    </ul>

    <div class="weight" data-reveal>
      <h3 class="weight-title"><Lines text={t('weight.title')} /></h3>
      <p class="weight-lead"><Lines text={t('weight.lead')} /></p>
      <div class="weight-kinds">
        <div class="weight-kind">
          <p class="weight-name">{t('weight.memory.name')}</p>
          <p>{t('weight.memory.what')}</p>
          <p class="weight-state">{t('weight.memory.state')}</p>
        </div>
        <div class="weight-kind weight-kind--heavy">
          <p class="weight-name">{t('weight.sessions.name')}</p>
          <p>{t('weight.sessions.what')}</p>
          <p class="weight-state">{t('weight.sessions.state')}</p>
        </div>
      </div>
      <figure class="weight-bars" aria-label={t('weight.figure')}>
        <figcaption>{t('weight.example')}</figcaption>
        <div class="weight-row">
          <span class="weight-bar weight-bar--memory" style={`width: ${memoryShare}%`}></span>
          <span class="weight-size">{t('weight.memory.size', { value: number.format(weightExample.memoryMb) })}</span>
        </div>
        <div class="weight-row">
          <span class="weight-bar weight-bar--sessions" style="width: 100%"></span>
          <span class="weight-size">{t('weight.sessions.size', { value: number.format(weightExample.sessionsMb) })}</span>
        </div>
      </figure>
      <p class="weight-note"><Lines text={t('weight.note')} /></p>
    </div>
    <p class="pilot" data-reveal><Lines text={t('pricing.pilot')} /></p>
  </div>
</section>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (min-width: 760px) {
    .plans {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .plans {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 14px;
    }
  }

  .plan {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 4px;
    min-width: 0;
    padding: 24px 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .plan--free {
    grid-column: 1 / -1;
    border-color: rgb(124 157 255 / 0.45);
    background: linear-gradient(180deg, rgb(46 91 228 / 0.16), rgb(46 91 228 / 0.03)), var(--surface);
  }

  @media (min-width: 1100px) {
    .plan--free {
      grid-column: auto;
    }
  }

  /* the free plan's condition: a mark beside its caption, the text on hover or focus — every card keeps one height */
  .plan-hint {
    position: relative;
    display: inline-block;
    margin-left: 6px;
    vertical-align: middle;
  }

  .plan-hint-mark {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--fg-muted);
    font-size: 11px;
    line-height: 1;
    cursor: help;
  }

  .plan-hint-text {
    position: absolute;
    z-index: 5;
    bottom: calc(100% + 8px);
    left: 50%;
    display: grid;
    gap: 4px;
    width: min(280px, 80vw);
    padding: 10px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--bg-soft);
    color: var(--fg-soft);
    font-size: 13px;
    line-height: 1.45;
    text-align: left;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .plan-hint:hover .plan-hint-text,
  .plan-hint-mark:focus-visible + .plan-hint-text {
    opacity: 1;
    transform: translateX(-50%);
  }

  .plan-size {
    color: var(--fg);
    font-family: var(--font-title);
    font-size: 30px;
    font-weight: 700;
    line-height: 1.1;
  }

  .plan-price {
    margin-top: 8px;
    color: var(--brand-bright);
    font-family: var(--font-accent);
    font-size: 20px;
    font-weight: 600;
  }

  .plan-period {
    margin-bottom: 18px;
    color: var(--fg-faint);
    font-size: 14px;
  }

  .plan .btn {
    width: 100%;
    min-height: 42px;
    padding-inline: 10px;
    font-size: 15px;
  }

  .weight {
    display: grid;
    gap: 16px;
    max-width: 860px;
    margin: 48px auto 0;
    padding: 28px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .weight-title {
    font-family: var(--font-title);
    font-size: 24px;
    line-height: 1.2;
  }

  .weight-lead,
  .weight-note {
    display: grid;
    gap: 2px;
    color: var(--fg-muted);
  }

  .weight-kinds {
    display: grid;
    gap: 12px;
  }

  @media (min-width: 640px) {
    .weight-kinds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .weight-kind {
    display: grid;
    gap: 6px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--fg-soft);
    font-size: 15px;
  }

  .weight-kind--heavy {
    border-color: rgb(124 157 255 / 0.45);
  }

  .weight-name {
    color: var(--fg);
    font-weight: 600;
  }

  .weight-state {
    color: var(--fg-faint);
    font-size: 13px;
  }

  .weight-bars {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .weight-bars figcaption {
    color: var(--fg-faint);
    font-size: 13px;
  }

  .weight-row {
    display: grid;
    gap: 4px;
  }

  .weight-bar {
    display: block;
    height: 12px;
    border-radius: 6px;
  }

  .weight-bar--memory {
    min-width: 4px;
    background: var(--brand-bright);
  }

  .weight-bar--sessions {
    background: linear-gradient(90deg, #b9c9ff, var(--brand-bright));
  }

  .weight-size {
    color: var(--fg-soft);
    font-family: var(--font-accent);
    font-size: 13px;
  }

  .pilot {
    display: grid;
    gap: 2px;
    max-width: 680px;
    margin: 32px auto 0;
    padding: 16px 20px;
    border: 1px dashed var(--border-strong);
    border-radius: 12px;
    color: var(--fg-muted);
    font-size: 15px;
    text-align: center;
  }
</style>
