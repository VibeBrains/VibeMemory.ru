---
import Lines from '@vibebrains/site-kit/components/Lines.astro'
import Mark from './Mark.astro'
import type { Lang } from '@vibebrains/site-kit/languages'
import { links } from '../config/site'
import { useTranslations } from '../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { t } = useTranslations(lang)
---

<section class="section cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="panel" data-reveal>
      <div class="panel-glow" aria-hidden="true"></div>
      <Mark size={56} animated />
      <h2 class="section-title" id="cta-title">{t('cta.title')}</h2>
      <p class="section-lead"><Lines text={t('cta.text')} /></p>
      <div class="actions">
        <a class="btn btn--primary btn--lg" href={links.start} data-goal="start_click">{t('cta.primary')}</a>
        <a class="btn btn--ghost btn--lg" href={links.signIn} data-goal="signin_click">{t('cta.secondary')}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 20px;
    padding: clamp(40px, 7vw, 80px) 24px;
    border: 1px solid rgb(124 157 255 / 0.3);
    border-radius: 28px;
    background: linear-gradient(180deg, #121833, #0c0e18);
    text-align: center;
    overflow: hidden;
  }

  .panel-glow {
    position: absolute;
    inset: auto -20% -60% -20%;
    height: 120%;
    background: radial-gradient(closest-side, rgb(46 91 228 / 0.45), transparent);
    pointer-events: none;
  }

  .panel > :not(.panel-glow) {
    position: relative;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
</style>
